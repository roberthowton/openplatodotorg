---
import SwanIcon from "../assets/icons/swan.svg?raw";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="copyright">
    © {year} Open Plato Project. All rights reserved.
  </p>
  <span class="footer-swan" aria-hidden="true" set:html={SwanIcon} />
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 40;
  }

  .copyright {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .footer-swan {
    position: absolute;
    right: var(--space-lg);
    display: flex;
    align-items: center;
    color: var(--color-text-muted);
  }

  .footer-swan :global(svg) {
    width: 24px;
    height: 24px;
  }
</style>

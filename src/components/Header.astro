---
import { ShowState } from "../types";
import SwanIcon from "../assets/icons/swan.svg?raw";
import LogoSvg from "../assets/icons/logo.svg?raw";

const urlShowParams = Astro.url.searchParams.getAll("show") as ShowState[];
const isFirstRead = urlShowParams.includes(ShowState.FIRST_READ);
const isScholarly = !isFirstRead;

// For mobile language toggle in scholarly mode
const showGreek = urlShowParams.includes(ShowState.GREEK) || urlShowParams.length === 0;
const showEnglish = urlShowParams.includes(ShowState.ENGLISH) || urlShowParams.length === 0;
const showBoth = showGreek && showEnglish;
---

<site-header>
<header class="site-header">
  <div class="header-left">
    <nav class="mode-toggle" role="tablist" aria-label="Reading mode">
      <button
        class:list={["mode-btn", { active: isFirstRead }]}
        data-mode="firstRead"
        role="tab"
        aria-selected={isFirstRead}
      >
        FIRST READ
      </button>
      <button
        class:list={["mode-btn", { active: isScholarly }]}
        data-mode="scholarly"
        role="tab"
        aria-selected={isScholarly}
      >
        SCHOLARLY
      </button>
    </nav>
  </div>

  <div class="header-center">
    <a href="/" class="logo" aria-label="Open Plato home">
      <span class="logo-swan" aria-hidden="true" set:html={SwanIcon} />
      <span class="logo-text" aria-hidden="true" set:html={LogoSvg} />
    </a>
  </div>

  <div class="header-right">
    {/* Mobile language toggle - only in scholarly mode */}
    {isScholarly && (
      <nav class="lang-toggle" role="tablist" aria-label="Language view">
        <button
          class:list={["lang-btn", { active: showGreek && !showEnglish }]}
          data-lang="gr"
          role="tab"
          aria-selected={showGreek && !showEnglish}
        >
          GREEK
        </button>
        <button
          class:list={["lang-btn", { active: showEnglish && !showGreek }]}
          data-lang="en"
          role="tab"
          aria-selected={showEnglish && !showGreek}
        >
          TRANSLATION
        </button>
      </nav>
    )}
    <div class="theme-toggle-group" aria-label="Color theme">
      <button class="theme-btn" data-theme-option="light" aria-label="Light mode">
        LIGHT MODE
      </button>
      <button class="theme-btn" data-theme-option="dark" aria-label="Dark mode">
        DARK MODE
      </button>
    </div>
  </div>
</header>
</site-header>

<script>
  import { createHeaderElement } from "./HeaderElement";
  customElements.define("site-header", createHeaderElement());
</script>

<style>
  site-header {
    display: block;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-header-bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-left,
  .header-right {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .header-right {
    justify-content: flex-end;
    gap: var(--space-md);
  }

  .header-center {
    flex: 0 0 auto;
  }

  /* Mode toggle — radio circle style */
  .mode-toggle {
    display: flex;
    gap: var(--space-lg);
  }

  .mode-btn {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4em;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .mode-btn::before {
    content: '○';
    font-size: 0.7em;
    line-height: 1;
  }

  .mode-btn.active {
    color: var(--color-text);
  }

  .mode-btn.active::before {
    content: '●';
  }

  .mode-btn:hover {
    color: var(--color-text);
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
  }

  .logo-swan {
    display: flex;
    color: var(--color-text);
  }

  .logo-swan :global(svg) {
    width: 32px;
    height: 32px;
  }

  .logo-text {
    display: flex;
    align-items: center;
    font-family: var(--font-serif);
    font-weight: var(--weight-light);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .logo-text :global(svg) {
    height: 1.5rem;
    width: auto;
    overflow: visible;
  }

  /* Theme toggle — dual radio circle style */
  .theme-toggle-group {
    display: flex;
    gap: var(--space-lg);
  }

  .theme-btn {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4em;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .theme-btn::before {
    content: '○';
    font-size: 0.7em;
    line-height: 1;
  }

  .theme-btn.active {
    color: var(--color-text);
  }

  .theme-btn.active::before {
    content: '●';
  }

  .theme-btn:hover {
    color: var(--color-text);
  }

  /* Mobile language toggle - hidden on desktop */
  .lang-toggle {
    display: none;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .lang-btn {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    padding: var(--space-xs) var(--space-sm);
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .lang-btn:hover {
    color: var(--color-text);
  }

  .lang-btn.active {
    background: var(--op-yellow);
    color: var(--black-1);
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .site-header {
      padding: var(--space-sm) var(--space-md);
    }

    .logo-text {
      display: none;
    }

    .theme-toggle-group {
      display: none;
    }

    .mode-btn {
      padding: var(--space-xs) var(--space-sm);
      font-size: 0.65rem;
    }

    /* Show language toggle on mobile */
    .lang-toggle {
      display: flex;
    }
  }

  /* Tablet - Portrait */
  @media (min-width: 769px) and (max-width: 1024px) and (orientation: portrait) {
    .site-header {
      padding: var(--space-sm) var(--space-md);
    }

    .logo-text {
      font-size: 1.25rem;
    }
  }
</style>

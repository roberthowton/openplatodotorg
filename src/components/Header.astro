---
import { ShowState } from "../types";

const urlShowParams = Astro.url.searchParams.getAll("show") as ShowState[];
const isFirstRead = urlShowParams.includes(ShowState.FIRST_READ);
const isScholarly = !isFirstRead;

// For mobile language toggle in scholarly mode
const showGreek = urlShowParams.includes(ShowState.GREEK) || urlShowParams.length === 0;
const showEnglish = urlShowParams.includes(ShowState.ENGLISH) || urlShowParams.length === 0;
const showBoth = showGreek && showEnglish;
---

<site-header>
<header class="site-header">
  <div class="header-left">
    <nav class="mode-toggle" role="tablist" aria-label="Reading mode">
      <button
        class:list={["mode-btn", { active: isFirstRead }]}
        data-mode="firstRead"
        role="tab"
        aria-selected={isFirstRead}
      >
        FIRST READ
      </button>
      <button
        class:list={["mode-btn", { active: isScholarly }]}
        data-mode="scholarly"
        role="tab"
        aria-selected={isScholarly}
      >
        SCHOLARLY
      </button>
    </nav>
  </div>

  <div class="header-center">
    <a href="/" class="logo" aria-label="Open Plato home">
      <svg class="logo-swan" width="32" height="32" viewBox="0 0 194.41 157.71" fill="currentColor" aria-hidden="true">
        <path d="m 0,0 c -4.073,-1.654 -9.613,-5.393 -10.891,-2.304 -0.875,2.114 0.413,3.783 2.317,4.936 3.007,1.821 3.258,4.718 -2.259,4.525 -5.323,-0.187 -11.852,-2.879 -16.262,-1.216 -6.417,2.42 -2.363,7.125 0.779,6.338 3.683,-0.923 5.223,-2.097 6.973,-0.591 1.749,1.507 -5.768,10.236 -21.837,16.065 -16.069,5.828 -41.134,-3.414 -52.861,-13.627 -5.482,-4.775 -6.581,-6.551 -8.614,-5.711 -3.388,1.4 6.231,11.894 10.946,18.019 6.857,8.911 18.799,28.459 18.085,41.879 -0.635,11.936 -7.49,22.346 -23.98,21.558 -16.361,-0.783 -25.107,-14.32 -25.107,-14.32 0,0 -12.402,-12.546 -8.156,-26.992 0,0 0.594,-2.127 2.703,-2.288 0.405,-0.012 0.921,0.106 1.256,0.333 0.738,0.502 0.957,1.289 0.728,2.004 -0.132,0.413 -0.454,0.812 -0.454,1.251 0,0.806 0.653,1.459 1.458,1.459 0.574,0 1.107,-0.349 1.337,-0.874 0.084,-0.192 0.129,-0.533 0.117,-0.729 0.117,-0.21 -0.018,-0.78 -0.359,-1.44 -0.134,-0.305 -0.294,-0.601 -0.494,-0.893 -0.177,-0.259 -0.425,-0.517 -0.709,-0.736 -0.381,-0.371 -0.821,-0.7 -1.314,-0.93 -3.096,-1.448 -2.651,-1.894 -3.863,-7.233 0,0.001 0,0.001 0,0.001 -0.25,-0.998 -0.567,-2.101 -0.972,-3.311 -2.194,-6.549 -4.878,-9.23 -1.546,-8.413 3.332,0.817 12.693,13.914 12.693,13.914 0,0 6.916,7.599 10.471,22.891 1.037,4.459 3.226,8.915 7.175,11.47 3.227,2.087 7.08,2.319 10.438,-1.221 3.96,-4.175 3.957,-10.993 -0.227,-17.795 -4.43,-7.203 -9.548,-12.363 -14.105,-17.258 -20.805,-22.346 -28.289,-23.722 -32.213,-41.509 -6.134,-27.803 29.3,-25.583 44.164,-17.588 9.591,5.159 19.072,12.39 21.742,8.279 1.787,-2.752 -1.093,-4.908 -2.001,-10.284 -0.908,-5.376 10.489,-7.01 18.51,0.789 8.02,7.798 12.498,8.162 15.49,7.659 1.873,-0.315 5.674,-3.185 2.862,-9.216 -2.363,-5.07 -0.113,-6.696 10.276,-3.907 10.39,2.79 21.061,16.791 25.795,20.338 4.733,3.546 7.634,4.234 8.192,5.002 C 6.842,-0.908 4.073,1.655 0,0" transform="matrix(1.3333333,0,0,-1.3333333,185.934,120.003)" />
      </svg>
      <span class="logo-text">Open Plato</span>
    </a>
  </div>

  <div class="header-right">
    {/* Mobile language toggle - only in scholarly mode */}
    {isScholarly && (
      <nav class="lang-toggle" role="tablist" aria-label="Language view">
        <button
          class:list={["lang-btn", { active: showGreek && !showEnglish }]}
          data-lang="gr"
          role="tab"
          aria-selected={showGreek && !showEnglish}
        >
          GREEK
        </button>
        <button
          class:list={["lang-btn", { active: showEnglish && !showGreek }]}
          data-lang="en"
          role="tab"
          aria-selected={showEnglish && !showGreek}
        >
          TRANSLATION
        </button>
      </nav>
    )}
    <button class="search-btn" aria-label="Search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
        <path d="M16 16L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme">
      <span class="theme-label">LIGHT MODE</span>
    </button>
  </div>
</header>
</site-header>

<script>
  import { createHeaderElement } from "./HeaderElement";
  customElements.define("site-header", createHeaderElement());
</script>

<style>
  site-header {
    display: block;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-left,
  .header-right {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .header-right {
    justify-content: flex-end;
    gap: var(--space-md);
  }

  .header-center {
    flex: 0 0 auto;
  }

  /* Mode toggle */
  .mode-toggle {
    display: flex;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .mode-btn {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: var(--space-sm) var(--space-md);
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .mode-btn:hover {
    color: var(--color-text);
  }

  .mode-btn.active {
    background: var(--op-yellow);
    color: var(--black-1);
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
  }

  .logo-swan {
    color: var(--color-text);
  }

  .logo-text {
    font-family: var(--font-serif);
    font-weight: var(--weight-light);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  /* Search button */
  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .search-btn:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  /* Theme toggle */
  .theme-toggle {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: var(--space-sm) var(--space-md);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  /* Mobile language toggle - hidden on desktop */
  .lang-toggle {
    display: none;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .lang-btn {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    padding: var(--space-xs) var(--space-sm);
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .lang-btn:hover {
    color: var(--color-text);
  }

  .lang-btn.active {
    background: var(--op-yellow);
    color: var(--black-1);
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .site-header {
      padding: var(--space-sm) var(--space-md);
    }

    .logo-text {
      display: none;
    }

    .theme-toggle .theme-label {
      display: none;
    }

    .mode-btn {
      padding: var(--space-xs) var(--space-sm);
      font-size: 0.65rem;
    }

    /* Show language toggle on mobile */
    .lang-toggle {
      display: flex;
    }

    .search-btn {
      display: none;
    }
  }

  /* Tablet - Portrait */
  @media (min-width: 769px) and (max-width: 1024px) and (orientation: portrait) {
    .site-header {
      padding: var(--space-sm) var(--space-md);
    }

    .logo-text {
      font-size: 1.25rem;
    }
  }
</style>

---
// Side panel for displaying comments/commentary
import LockOpenIcon from "../assets/icons/lock-open.svg?raw";
import LockClosedIcon from "../assets/icons/lock-closed.svg?raw";
import CloseIcon from "../assets/icons/close.svg?raw";
import { COMMENTS_LABELS } from "../consts/labels";

type Props = {
  labels?: Partial<typeof COMMENTS_LABELS>;
};

const labels = { ...COMMENTS_LABELS, ...Astro.props.labels };
---

<comments-panel id="comments-panel" class="comments-panel collapsed">
  <button id="comments-panel-toggle" class="comments-panel-toggle" aria-label={labels.ARIA_TOGGLE}>
    <span class="toggle-label">{labels.TOGGLE_LABEL}</span>
  </button>
  <header class="comments-panel-header">
    <h2>{labels.HEADER}</h2>
    <div class="comments-panel-actions">
      <button id="comments-panel-pin" class="comments-panel-btn" aria-label={labels.ARIA_PIN} title={labels.TITLE_PIN}>
        <span class="icon-lock-open" aria-hidden="true" set:html={LockOpenIcon} />
        <span class="icon-lock-closed" aria-hidden="true" set:html={LockClosedIcon} />
      </button>
      <button id="comments-panel-close" class="comments-panel-btn" aria-label={labels.ARIA_CLOSE} title={labels.TITLE_CLOSE}>
        <span aria-hidden="true" set:html={CloseIcon} />
      </button>
    </div>
  </header>
  <div id="comments-panel-content" class="comments-panel-content">
    <p class="comments-panel-empty">{labels.EMPTY_STATE}</p>
  </div>
</comments-panel>

<script>
  import { createCommentsPanelElement } from "./CommentsPanelElement";
  customElements.define("comments-panel", createCommentsPanelElement());
</script>

<style>
  .comments-panel {
    position: fixed;
    right: 0;
    top: 0;
    width: 320px;
    height: 100vh;
    background: var(--op-yellow);
    display: flex;
    flex-direction: column;
    z-index: 100;
    font-family: var(--font-body);
    color: var(--black-1);
    transition: transform var(--transition-normal);
  }

  .comments-panel.collapsed {
    transform: translateX(100%);
  }

  /* Vertical tab on right edge when collapsed */
  .comments-panel-toggle {
    position: absolute;
    left: -40px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: auto;
    padding: var(--space-md) var(--space-xs);
    background: var(--op-yellow);
    border: none;
    border-radius: 8px 0 0 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 101;
    box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
  }

  .comments-panel-toggle:hover {
    filter: brightness(0.95);
  }

  .toggle-label {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--black-1);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
  }

  /* Hide toggle when panel is open */
  .comments-panel:not(.collapsed) .comments-panel-toggle {
    opacity: 0;
    pointer-events: none;
  }

  .comments-panel-header {
    padding: var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .comments-panel-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--black-1);
  }

  .comments-panel-actions {
    display: flex;
    gap: var(--space-sm);
  }

  .comments-panel-btn {
    background: none;
    border: none;
    padding: var(--space-xs);
    cursor: pointer;
    color: var(--black-1);
    opacity: 0.6;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity var(--transition-fast);
  }

  .comments-panel-btn:hover {
    opacity: 1;
  }

  /* Icon sizes */
  .comments-panel-btn :global(svg) {
    width: 20px;
    height: 20px;
  }

  /* Lock icon states */
  .icon-lock-open,
  .icon-lock-closed {
    display: flex;
  }

  .icon-lock-closed {
    display: none;
  }

  .comments-panel.pinned .icon-lock-open {
    display: none;
  }

  .comments-panel.pinned .icon-lock-closed {
    display: block;
  }

  .comments-panel.pinned #comments-panel-pin {
    opacity: 1;
  }

  /* Overlay mode shadow */
  .comments-panel:not(.collapsed):not(.pinned) {
    box-shadow: -4px 0 15px rgba(0, 0, 0, 0.15);
  }

  .comments-panel-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-md);
  }

  .comments-panel-empty {
    color: var(--black-1);
    opacity: 0.6;
    font-style: italic;
  }

  .comment-item {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .comment-item:last-child {
    border-bottom: none;
  }

  .comment-item-id {
    font-size: 0.75rem;
    color: var(--black-1);
    opacity: 0.6;
    margin-bottom: var(--space-sm);
    font-family: monospace;
  }

  .comment-item-body {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--black-1);
  }

  /* Mobile: bottom sheet */
  @media (max-width: 768px) {
    .comments-panel {
      width: 100%;
      height: 50vh;
      top: auto;
      bottom: 0;
      border-radius: 16px 16px 0 0;
    }

    .comments-panel.collapsed {
      transform: translateY(100%);
    }

    .comments-panel-toggle {
      left: 50%;
      top: -48px;
      transform: translateX(-50%);
      width: auto;
      height: 40px;
      padding: var(--space-xs) var(--space-md);
      border-radius: 8px 8px 0 0;
      writing-mode: horizontal-tb;
    }

    .toggle-label {
      writing-mode: horizontal-tb;
      transform: none;
    }

    /* Hide pin button on mobile */
    #comments-panel-pin {
      display: none;
    }
  }

</style>

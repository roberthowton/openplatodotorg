{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-push-coverage.sh",
            "statusMessage": "Running coverage check before push...",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
